# エディタ用 Claude on Bedrock — 国内完結 PoC 環境変数サンプル
#
# 使い方:
#   cp .env.sample .env   # .env は .gitignore 済み（コミットしない）
#   .env の値を実値に置き換える
#   ./scripts/deploy.sh   # deploy.sh が .env を読み込んで Terraform を実行

# ---- AWS 接続先 --------------------------------------------------------------
# 空なら現在の既定プロファイル/環境変数の認証情報を使用
AWS_PROFILE=
# データ所在の前提。東京固定（jp. プロファイルの呼び出し元エンドポイント）
AWS_REGION=ap-northeast-1

# ---- 検証対象モデル（2026-07-14 実測済みの値。変わっていないか scripts/01 で確認）----
JP_PROFILE_ID=jp.anthropic.claude-opus-4-8
# ネガティブテスト用: jp. 以外（IAM で拒否されることを実証する）
NON_JP_PROFILE_ID=global.anthropic.claude-opus-4-8

# ---- IAM / キー運用 -----------------------------------------------------------
# PoC 用 IAM ユーザー名（Terraform が作成。エディタ利用者を模す）
POC_USER_NAME=editor-claude-poc
# Bedrock API キー（長期）の有効期限日数。週次ローテ運用にマップするなら 7
API_KEY_EXPIRY_DAYS=7
# scripts/10-issue-api-key.sh で発行したキーをここに設定（Bearer トークン）。秘密。
AWS_BEARER_TOKEN_BEDROCK=

# ---- 通知（必須）---------------------------------------------------------------
# Teams Workflows (Power Automate「Webhook 要求を受信したとき」) の URL。秘密。
# 週次キーローテーション（毎週月曜 09:00 JST）の新キー投稿先。Azure 版と同じチャネルで可
TEAMS_WEBHOOK_URL=

# ---- 利用者プロファイル管理 Web UI（EntraID 認証・必須）------------------------
# Entra 管理センターでアプリ登録（SPA）を作り、その値を設定する。詳細は docs/setup-profile-ui.md
# テナント ID（ディレクトリ ID）
ENTRA_TENANT_ID=
# 登録した SPA アプリのアプリケーション（クライアント）ID
ENTRA_CLIENT_ID=

# ---- コスト上限（必須）---------------------------------------------------------
# 月次予算（USD）。PoC 想定の 2〜3 倍を目安に
MONTHLY_BUDGET_USD=200
# Budget ソフト通知（50/75/90%）の宛先メール
OPS_EMAIL=ops@example.com
